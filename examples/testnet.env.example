# Example environment for deploying/invoking a contract from this repo
# against Stellar testnet. Copy to `testnet.env`, fill in your values, and
# `source testnet.env` before running the Quick start commands in the
# README or scripts/deploy-testnet.sh.

# Name of a local Soroban/Stellar CLI identity to sign transactions with.
# Create one first with:
#   stellar keys generate --global my-testnet-key --network testnet
# then set this to that identity's name (not its address).
STELLAR_SOURCE=my-testnet-key

# Network alias understood by the Stellar CLI's built-in network presets.
# `stellar contract deploy ... --network testnet` already implies the
# passphrase/RPC URL below, so this is only needed if you're calling the
# CLI without `--network` and passing `--rpc-url`/`--network-passphrase`
# explicitly instead.
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# ---------------------------------------------------------------------------
# Published testnet contract IDs (README table)
# ---------------------------------------------------------------------------
# After a successful deploy, the deploy scripts record the new contract IDs
# in `testnet-ids.json` at the repo root. That file is the source of truth
# for the "Testnet contract IDs" table in the README, which is regenerated
# automatically by:
#
#   node scripts/update-testnet-ids.mjs
#
# Run that script (or let the deploy scripts run it for you) after deploying
# so the README reflects the latest release. To verify in CI that the README
# is up to date without modifying any files, use check mode:
#
#   node scripts/update-testnet-ids.mjs --check
#
# `--check` exits non-zero if the README table is stale relative to
# `testnet-ids.json`, so it can be wired into a pre-commit hook or CI job.
# Commit both `testnet-ids.json` and the regenerated README together.