{
  "name": "compliance-primitives-tooling",
  "private": true,
  "version": "1.0.0",
  "description": "Node tooling for this repo — currently just the automated accessibility audit of web/index.html. The site itself (web/) is plain HTML/CSS with no JS dependencies.",
  "scripts": {
    "check-accessibility": "node scripts/check-accessibility.mjs",
    "changelog:generate": "git-cliff --config cliff.toml --output CHANGELOG.md",
    "changelog:check": "sh scripts/check-changelog.sh",
    "compliance-cli": "node tools/compliance-cli",
    "test-compliance-cli": "node --test tools/compliance-cli.test.js"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "git-cliff": "^2.6.1",
    "puppeteer": "^25.9.0"
  }
}